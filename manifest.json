{
  "manifest_version": 3,
  "name": "ABES Attendance Tracker",
  "version": "5.1.0",
  "description": "Track your ABES ERP attendance, date-wise history, and 75% target locally in your browser.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://erp.abes.ac.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ABES Attendance Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}